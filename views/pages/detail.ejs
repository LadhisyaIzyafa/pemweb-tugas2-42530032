<%- include('../partials/header') %>

<div class="card detail">
  <img class="poster-detail" src="/img/<%= film.poster %>" alt="Poster <%= film.judul %>">
  <h1><%= film.judul %></h1>
  <p class="meta">Sutradara: <%= film.sutradara %></p>
  <p class="meta">Tahun rilis: <%= film.tahun %></p>
  <p><span class="tag"><%= film.genre %></span></p>
  <h2>Sinopsis</h2>
  <p><%= film.sinopsis %></p>
  <p><a class="btn" href="/">&larr; Kembali ke katalog</a></p>
</div>

<%- include('../partials/footer') %>